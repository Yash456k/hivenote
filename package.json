{
  "name": "hivenote",
  "version": "0.3.0",
  "description": "One shared notebook for all your AI agents: notes, tasks and handoffs across Claude Code, Codex, Hermes and more, with a live dashboard.",
  "type": "module",
  "bin": {
    "hivenote": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./sqlite": "./dist/sqlite.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "skills",
    "ui",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.mjs",
    "bench": "npm run build && node scripts/bench.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yash456k/hivenote.git"
  },
  "keywords": [
    "ai-agents",
    "claude-code",
    "codex",
    "agent-memory",
    "shared-memory",
    "mcp",
    "sqlite",
    "cli"
  ],
  "homepage": "https://www.npmjs.com/package/hivenote"
}
